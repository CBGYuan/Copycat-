__pycache__/
*.pyc
.venv/
venv/
configs/keys_local.py
data/cache/
# Skill storage is entirely local/generated, never checked in: local/ is each
# engineer's own personal edits, shared_cache/ is an auto-refreshed read-only
# mirror of the shared corp drive (see services.skill_service.
# refresh_shared_cache) regenerated on every app startup and may contain
# another engineer's contribution-file content.
data/skills/
# One-generation backup written beside the local skills file on every save
# (services.skill_service._write_skills_yaml) — a manual recovery aid, not a
# project file.
*.yaml.bak
# Reference papers dropped into data/ for local reading — not project
# deliverables, never checked in.
data/*.pdf
.vscode/
.claude/
# Local-only verification material: the pytest suite and the hand-written
# scenario notes are each engineer's own scratch work, not a deliverable.
tests/
docs/test_scenario_*.md
.pytest_cache/
# PyInstaller output — the exe ships as a release asset, never in the tree.
build/
dist/
